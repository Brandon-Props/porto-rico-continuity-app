# Copy to .env.local and fill in once you've created a Supabase project.
# Until these are set, the app runs fully local-first with no cloud sync
# (see ARCHITECTURE.md and src/lib/sync/index.ts) — that's expected and fine
# for on-set use with a single device, or for testing.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
